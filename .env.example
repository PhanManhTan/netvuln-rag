# Target profile: change these values to support another product
DATA_SOURCE=nvd
TARGET_VENDOR=fortinet
TARGET_PRODUCT=fortios
TARGET_PRODUCT_ALIASES=fortios,fortinet os
TARGET_CPE=cpe:2.3:o:fortinet:fortios:*:*:*:*:*:*:*:*

# Data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Source API (defaults below are for the NVD adapter)
SOURCE_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
SOURCE_API_KEY=
SOURCE_PAGE_SIZE=2000
SOURCE_REQUEST_DELAY=6

# Embedding and Qdrant
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=netvuln_vulnerabilities_v1
TOP_K=5
MIN_SCORE=0.0

# LLM: ollama or openai
LLM_PROVIDER=ollama
LLM_TIMEOUT=120
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini


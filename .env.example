# Product catalog
DATA_SOURCE=nvd
DEFAULT_PRODUCT_ID=fortios
# Leave blank to use the bundled proposal catalog.
PRODUCT_CONFIG_FILE=

# Storage roots. Relative paths resolve from the project root.
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# Source API (defaults below are for the NVD adapter)
SOURCE_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
SOURCE_API_KEY=
SOURCE_PAGE_SIZE=2000
SOURCE_REQUEST_DELAY=6
SOURCE_REQUEST_TIMEOUT=60
SOURCE_MAX_RETRIES=3
SOURCE_RETRY_BACKOFF=2
SOURCE_USER_AGENT=netvuln-rag/0.1

# Embedding and Qdrant
EMBEDDING_PROVIDER=qdrant_cloud
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_BATCH_SIZE=32
# For local embeddings: auto selects the available device. Use cpu or cuda:0 to pin it.
EMBEDDING_DEVICE=auto
EMBEDDING_CACHE_DIR=
# Use http://localhost:6333 for a local Qdrant server.
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=netvuln_vulnerabilities_v1
TOP_K=5
MIN_SCORE=0.0

# LLM provider: gemini, groq, ollama, or openai
LLM_PROVIDER=groq
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=2048
CONTEXT_MAX_CHARS=6000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional provider settings
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini


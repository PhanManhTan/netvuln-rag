        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "NatAddress": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      },
      "DependsOn": "GatewayAttachment"
    },
    "Nat": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatAddress",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "EgressSubnet"
        }
      },
      "DependsOn": "EgressDefaultRoute"
    },
    "FRRAGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "FRR-A declared service flows and management SSH",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": "10.53.0.10/32",
            "Description": "Ansible management SSH only"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "10.53.10.10/32",
            "Description": "client-A-web"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 1024,
            "ToPort": 65535,
            "CidrIp": "10.53.20.13/32",
            "Description": "client-A-web return traffic"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": "10.53.10.10/32",
            "Description": "client-A-ssh"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 1024,
            "ToPort": 65535,
            "CidrIp": "10.53.20.11/32",
            "Description": "client-A-ssh return traffic"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": "10.53.10.10/32",
            "Description": "client-A-dns-tcp"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 1024,
            "ToPort": 65535,
            "CidrIp": "10.53.20.14/32",
            "Description": "client-A-dns-tcp return traffic"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": "10.53.10.10/32",
            "Description": "client-A-dns-udp"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 1024,
            "ToPort": 65535,
            "CidrIp": "10.53.20.14/32",
            "Description": "client-A-dns-udp return traffic"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 179,
            "ToPort": 179,
            "CidrIp": "10.53.1.11/32",
            "Description": "bgp-B"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 1194,
            "ToPort": 1194,
            "CidrIp": "10.53.11.20/32",
            "Description": "vpn-underlay"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 1024,
            "ToPort": 65535,
            "CidrIp": "10.53.10.20/32",
            "Description": "vpn-underlay return traffic"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0",
            "Description": "Bootstrap egress; destination ingress and router firewall enforce workload isolation"
          }
        ]
      }
    },

{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Complete NetVuln sixteen-version experiment: CloudFormation infrastructure, agentless Ansible install/facts and functional readiness",
  "Parameters": {
    "ArtifactsBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]"
    },
    "ArtifactsPrefix": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z0-9][a-zA-Z0-9/_-]*"
    },
    "BundleSha256": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{64}"
    },
    "FleetId": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9-]{0,99}"
    },
    "AmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Pinned Canonical Ubuntu Server 22.04 x86_64 AMI in this Region"
    },
    "ControlAmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Pinned Canonical Ubuntu Server 24.04 x86_64 AMI for Ansible/Python 3.12 control node"
    },
    "TargetInstanceType": {
      "Type": "String",
      "Default": "t3.medium",
      "AllowedValues": [
        "t3.small",
        "t3.medium",
        "t3.large",
        "t3.xlarge",
        "m6i.large",
        "m6i.xlarge"
      ]
    },
    "ManagementInstanceType": {
      "Type": "String",
      "Default": "t3.large",
      "AllowedValues": [
        "t3.small",
        "t3.medium",
        "t3.large",
        "t3.xlarge",
        "m6i.large",
        "m6i.xlarge"
      ]
    }
  },
  "Resources": {
    "Network": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": {
          "Fn::Sub": "https://${ArtifactsBucket}.s3.${AWS::Region}.${AWS::URLSuffix}/${ArtifactsPrefix}/templates/network.template.json"
        },
        "Parameters": {},
        "TimeoutInMinutes": 150
      }
    },
    "Management": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": {
          "Fn::Sub": "https://${ArtifactsBucket}.s3.${AWS::Region}.${AWS::URLSuffix}/${ArtifactsPrefix}/templates/management.template.json"
        },
        "Parameters": {
          "ArtifactsBucket": {
            "Ref": "ArtifactsBucket"
          },
          "ArtifactsPrefix": {
            "Ref": "ArtifactsPrefix"
          },
          "BundleSha256": {
            "Ref": "BundleSha256"
          },
          "AmiId": {
            "Ref": "ControlAmiId"
          },
          "FleetId": {
            "Ref": "FleetId"
          },
          "InstanceType": {
            "Ref": "ManagementInstanceType"
          },
          "SubnetId": {
            "Fn::GetAtt": [
              "Network",
              "Outputs.ManagementSubnetId"
            ]
          },
          "SecurityGroupId": {
            "Fn::GetAtt": [
              "Network",
              "Outputs.ManagementSecurityGroup"
            ]
          }
        },
        "TimeoutInMinutes": 150
      }
    },
    "FRRA": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": {
          "Fn::Sub": "https://${ArtifactsBucket}.s3.${AWS::Region}.${AWS::URLSuffix}/${ArtifactsPrefix}/templates/target.template.json"
        },
        "Parameters": {
          "ArtifactsBucket": {
            "Ref": "ArtifactsBucket"
          },
          "ArtifactsPrefix": {
            "Ref": "ArtifactsPrefix"
          },
          "BundleSha256": {
            "Ref": "BundleSha256"
          },
          "AmiId": {
            "Ref": "AmiId"
          },
          "FleetId": {
            "Ref": "FleetId"
          },
          "InstanceType": {
            "Ref": "TargetInstanceType"
          },
          "DeviceId": "FRR-A",
          "DeviceKey": "FRRA",
          "SubnetId": {
            "Fn::GetAtt": [
              "Network",
              "Outputs.RouterSubnetId"
            ]
          },
          "SecurityGroupId": {
            "Fn::GetAtt": [
              "Network",
              "Outputs.FRRASecurityGroup"
